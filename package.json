{
  "name": "webby",
  "version": "0.1.0",
  "description": "Drop a simple static HTML app and serve or publish it to localhost, Tailscale, Cloudflare Pages, or custom hosts.",
  "type": "module",
  "bin": {
    "webby": "./src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "webby": "bun run ./src/cli.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^2"
  }
}
