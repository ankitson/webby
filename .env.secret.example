# Copy to `.env.secret` and fill in. `.env.secret` is gitignored.

# Cloudflare account id that owns the Pages project.
CF_ACCOUNT_ID=

# 1Password secret reference for the Cloudflare API token (needs Pages: Edit).
# The token is read via `op read` at deploy time and never written to disk.
CF_TOKEN_REF=op://<vault>/<item>/password

# Domains the bags are served at.
INTERNAL_URL=https://tools.example.com
PUBLIC_URL=https://mini.example.com

# Optional overrides (not secret; sensible defaults live in webby.config.ts).
INTERNAL_DIR=/projects/html-bag/app
PUBLIC_DIR=/projects/webby/public
PUBLIC_PROJECT=webby
