# Optional local env file for webby development/private setups.
# `.env.secret` is gitignored. OSS users can usually use real environment
# variables plus ~/.config/webby/config.json instead.

# Cloudflare Pages.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PUBLIC_PROJECT=webby
PUBLIC_URL=https://mini.example.com
PUBLIC_DIR=/projects/webby/public

# Optional 1Password compatibility. If set, webby reads the token with:
# op read "$CF_TOKEN_REF"
CF_TOKEN_REF=op://<vault>/<item>/password

# Optional Caddy/static-file-server compatibility.
INTERNAL_URL=https://tools.example.com
INTERNAL_DIR=/projects/webby/internal

# Optional defaults.
WEBBY_DEFAULT_BAG=local
WEBBY_LOCAL_PORT=8765
TAILSCALE_PATH=/
